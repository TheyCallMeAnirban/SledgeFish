{
  "manifest_version": 3,
  "name": "SledgeFish Lite - Chess Commentator",
  "version": "0.1.0",
  "description": "A lightweight, personality-driven chess commentator that reacts to moves on Chess.com in real time.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "lib/chess.min.js",
        "positionManager.js",
        "scoreNormalizer.js",
        "engine/uciParser.js",
        "engine/stockfishAdapter.js",
        "moveClassifier.js",
        "tacticalInterpreter.js",
        "speechController.js",
        "moveTracker.js",
        "eventClassifier.js",
        "commentaryEngine.js",
        "overlay.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SledgeFish Lite Settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "engine/stockfish.worker.js",
        "engine/stockfish.wasm",
        "lib/chess.min.js"
      ],
      "matches": [
        "https://www.chess.com/*"
      ]
    }
  ]
}
